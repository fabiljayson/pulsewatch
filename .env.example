# PulseWatch configuration examples.
# Copy to .env if you use a dotenv loader, or export these variables in your shell.
# All values below are safe, non-secret defaults.

# Path to the SQLite database file.
PULSEWATCH_DB_PATH=pulsewatch.db

# Overall HTTP request timeout for outbound health checks, in seconds.
PULSEWATCH_HTTP_TIMEOUT_SECONDS=5.0

# TCP connect timeout for outbound health checks, in seconds.
PULSEWATCH_HTTP_CONNECT_TIMEOUT_SECONDS=3.0

# Whether the checker follows HTTP redirects. Off by default: each redirect
# destination is validated only when this is enabled (hop-by-hop).
PULSEWATCH_ALLOW_REDIRECTS=false

# Maximum redirect hops to follow when PULSEWATCH_ALLOW_REDIRECTS=true.
PULSEWATCH_MAX_REDIRECTS=3

# Upper bound applied to the `limit` query parameter on history listings.
PULSEWATCH_HISTORY_MAX_LIMIT=100

# Default report window, in hours, for GET .../report.
PULSEWATCH_REPORT_DEFAULT_HOURS=24

# Display threshold for the derived "degraded" state: a successful latest check
# whose measured latency exceeds this many milliseconds is reported as degraded
# by GET /api/v1/summary and ?include_status=true. It is a reporting rule, not
# a monitoring scheduler setting.
PULSEWATCH_DEGRADED_LATENCY_MS=1000

# ── Authentication (optional) ──────────────────────────────────────────────
# When PULSEWATCH_ADMIN_PASSWORD is unset/empty, the API is OPEN (no login).
# Set it to require a single-admin login; sessions are stateless HMAC tokens
# valid for 24 hours and do not survive server restarts (per-process secret).
# PULSEWATCH_ADMIN_USERNAME=admin
# PULSEWATCH_ADMIN_PASSWORD=change-me-locally
