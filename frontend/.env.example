# PulseWatch frontend configuration.
# Copy to .env.local (git-ignored) and adjust if needed.

# Base URL for API requests. Leave empty to use same-origin requests, which is
# what the Vite dev server proxies to the backend (see vite.config.ts).
# Example for a separate API host: http://127.0.0.1:8000
VITE_API_BASE_URL=

# Backend target for the Vite dev-server proxy (development only).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
